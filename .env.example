# Database
# Production / Vercel (PostgreSQL):
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Local development with SQLite (optional):
# 1. Run: node scripts/switch-db.js sqlite
# 2. Set: DATABASE_URL="file:./dev.db"

# Admin
ADMIN_PASSWORD="admin123"

# JWT Secret (min 32 chars, required for production)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# Telegram (оплата через бота + уведомления админу)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_ADMIN_CHAT_ID="your_chat_id"
TELEGRAM_BOT_USERNAME="russiancupseasonbot"
# Релей до api.telegram.org (с российских IP Telegram API недоступен)
TG_API_ROOT="https://russiancup-tg-relay.vercel.app/api/tg"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo mode without database (optional)
# MOCK_MODE="true"
